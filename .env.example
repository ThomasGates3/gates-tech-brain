# ── AI Brain — environment ─────────────────────────────────────────────
# Copy to .env.local (gitignored) and fill in. Never commit real secrets.

# Anthropic API — REQUIRED to bring the brain online (chat, agents, "Draft with Claude").
# Create one at console.anthropic.com → API Keys. Set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Daily Claude budget across the whole Brain (chat, automations, Field copy, Ace).
# Warn (deck + Field status bar + Discord/Slack if a webhook is set), then hard stop.
CLAUDE_DAILY_WARN_USD=3
CLAUDE_DAILY_CAP_USD=5.5

# Runtime model tier for chat/orchestrator: "standard" (Sonnet 5.5) or "flagship" (Opus 5.5).
# Field "Draft with Claude" copy always uses Opus 5.5.
MODEL_TIER=standard

# Which vertical persona to run: agency | accounting | law | medical | insurance
VERTICAL=agency

# Neon Postgres (serverless) — for jobs, knowledge (pgvector), audit, approvals.
# Local dev works without it; needed for persistence.
DATABASE_URL=

# Security — password gate. Set ACCESS_PASSWORD to lock the whole app behind a
# single password (login at /sign-in). The gate turns on automatically once set.
# AUTH_SECRET signs the session cookie — REQUIRED in prod. openssl rand -base64 32
ACCESS_PASSWORD=
AUTH_SECRET=

# Optional: comma-separated allowed origins in production (CORS)
CORS_ORIGINS=

# Chat delivery — automations post their results here. Set EITHER (or both);
# each is a free webhook. Discord is easiest on mobile:
#   Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
#   Slack:   https://api.slack.com/messaging/webhooks
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Cron protection — Vercel Cron sends this as a Bearer token to /api/cron
CRON_SECRET=

# Connector credentials (vault keys) — one per connector you enable, e.g.:
# GITHUB_TOKEN=
# VERCEL_TOKEN=

# ── Business app connectors ─────────────────────────────────────────────
# For each app: URL = where it's reachable (deployed or localhost), TOKEN =
# the agent access token you add to that app's API so the Brain can call it.
TWIN_TRADING_URL=
TWIN_TRADING_TOKEN=
TWIN_TRADING_BIO_URL=
TWIN_TRADING_BIO_TOKEN=
AD_SYSTEM_URL=
AD_SYSTEM_TOKEN=
AI_LINK_BIO_URL=
AI_LINK_BIO_TOKEN=
GATES_TECH_URL=
GATES_TECH_TOKEN=
SPEED_TO_LEAD_URL=
SPEED_TO_LEAD_TOKEN=

# ── Moby dev-agent ──────────────────────────────────────────────────────
# The Brain spins up a coding agent (Claude Code) on the Moby repo.
MOBY_REPO_PATH=/Users/tg3/dev/moby
MOBY_DEV_ENABLED=false   # set true to let agents actually run (edits on a branch)
# CLAUDE_BIN=claude      # override if the CLI isn't on PATH

# ── Field Console (/field) — Email 1 cold outreach ──────────────────────
# Internal ops console for Thomas + Ace. See docs/field-console-PRD.md.
# Each person signs in at /sign-in with their own password; the password
# decides who they are. Approve + Send are Thomas-only unless FIELD_ACE_CAN_SEND=true (server-side).
FIELD_THOMAS_PASSWORD=
FIELD_ACE_PASSWORD=          # optional: only if Ace should also sign in to the web UI
# Ace is a bot: it calls /api/field/* with `Authorization: Bearer <this key>`.
# Generate with: openssl rand -base64 32
FIELD_ACE_API_KEY=
# Let Ace Approve + Send too (not just Thomas). Leave false until you're ready.
FIELD_ACE_CAN_SEND=false
# FIELD_DEV_OPERATOR=thomas   # local dev ONLY, when no password is set at all

# Morning pack source: Notion "Cold emails (paste)" data source.
# Create an internal integration (notion.so/profile/integrations), share the
# database with it, paste its secret here.
NOTION_TOKEN=
NOTION_COLD_EMAILS_DATA_SOURCE_ID=02fa0dc7-9082-4900-9592-69b54e2e42fe

# AgentMail — sends from the cold-domain inbox (e.g. thomas@trygates.tech).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# CAN-SPAM: physical mailing address, appended to every send. Sends are
# BLOCKED until this is set.
FIELD_MAILING_ADDRESS=
# Set true once the cold domain is warmed (outside the app). Shown, not faked.
FIELD_DOMAIN_WARMED=false
# Hard cap on Email 1 sends per day (console timezone). Protects the domain.
FIELD_DAILY_SEND_CAP=20
FIELD_TIMEZONE=America/New_York
FIELD_SENDER_NAME=Thomas Gates III
FIELD_SENDER_COMPANY=Gates Technologies
FIELD_SENDER_SITE=gatestech.solutions
# Optional: "Draft with Claude" uses ANTHROPIC_API_KEY (above). Without it,
# the deterministic Field playbook template still works.
